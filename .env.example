# ── FasoTALN — Variables d'environnement ─────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs réelles si nécessaire.
# Ne jamais committer .env dans git.

# ── HuggingFace ─────────────────────────────────────────────────────────────
# Optionnel : requis uniquement si les modèles Uriath/byt5-small-g2p-african
# ou Uriath/afro-xlmr-hybrid-sib200-masakhanews-5class-byt5 passent en privé.
HF_TOKEN=

# ── Assistant conversationnel (Mistral) ─────────────────────────────────────
# Optionnelle : sans elle, /api/chat répond 503 (widget affiche un message
# d'indisponibilité côté frontend).
MISTRAL_API_KEY=

# ── Traduction français -> mooré (CITADEL) ──────────────────────────────────
# Optionnelles : sans elles, /api/translate répond 503. Compte fourni par
# l'équipe CITADEL — français -> mooré uniquement, pas de dioula/bambara.
CITADEL_EMAIL=
CITADEL_PASSWORD=
