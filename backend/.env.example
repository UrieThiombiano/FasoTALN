# FasoXplore — variables d'environnement backend
# Copier ce fichier en .env et remplir les valeurs.

# API MT CITADEL (traduction français <-> mooré)
CITADEL_EMAIL=
CITADEL_PASSWORD=

# API TTS CITADEL (URL ngrok temporaire — à mettre à jour si elle change)
CITADEL_TTS_URL=https://splendid-giraffe-arriving.ngrok-free.app/api/tts_moore
CITADEL_S2S_URL=https://splendid-giraffe-arriving.ngrok-free.app/api/s2s

# Agent FasoGuide — modèle principal (clé gratuite sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Agent FasoGuide — fallback automatique (clé sur https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
