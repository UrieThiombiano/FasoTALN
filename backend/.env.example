# FasoTALN — variables d'environnement backend
# Copier ce fichier en .env et remplir les valeurs si nécessaire.

# HuggingFace — optionnel, utile uniquement si les repos de modèles
# (Uriath/byt5-small-g2p-african, Uriath/afro-xlmr-hybrid-...) passent en privé
HF_TOKEN=

# Mistral — optionnel, active l'assistant conversationnel (/api/chat)
MISTRAL_API_KEY=

# CITADEL — optionnel, active la traduction français -> mooré (/api/translate)
CITADEL_EMAIL=
CITADEL_PASSWORD=
